{
  "ci": {
    "collect": {
      "staticDistDir": "dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/compiler-playground/index.html",
        "http://localhost/memory-visualizer/index.html",
        "http://localhost/timing-demo/index.html",
        "http://localhost/sat-solver/index.html",
        "http://localhost/system-map/index.html",
        "http://localhost/atom/index.html",
        "http://localhost/dna/index.html",
        "http://localhost/particles/index.html",
        "http://localhost/universe/index.html",
        "http://localhost/hologram/index.html",
        "http://localhost/neural/index.html",
        "http://localhost/wormhole/index.html",
        "http://localhost/cpu/index.html",
        "http://localhost/rust-engine/index.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "preset": "lighthouse:no-pwa",
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],

        "categories:performance": ["warn", { "minScore": 0.7 }],

        "network-dependency-tree-insight": "off",

        "target-size": "error",
        "color-contrast": "error",
        "document-title": "error",
        "html-has-lang": "error",
        "image-alt": "error",
        "button-name": "error",
        "link-name": "error",
        "aria-valid-attr": "error",
        "duplicate-id-aria": "error"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
